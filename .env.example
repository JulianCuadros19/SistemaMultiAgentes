# Plantilla de variables de entorno.
# Copia este archivo como .env y completa los valores. El archivo .env nunca se versiona.

# --- Modelos de lenguaje: un identificador por nodo que invoca modelo (RNF-06) ---
MODELO_N3_DIALOGO=
MODELO_N5_SINTESIS=
MODELO_N8_ARQUITECTURA=
MODELO_N10_GENERACION=
MODELO_N14_VEREDICTO=
# Opcional: modelo del cliente simulado de las pruebas; si se omite, el de N3.
MODELO_CLIENTE_SIMULADO=

# --- Razonamiento por nodo: esfuerzo y límite de salida, razonamiento incluido (ADR-0008) ---
# Si el límite se agota en razonamiento, la respuesta llega vacía y se cobra igual.
ESFUERZO_N3_DIALOGO=low
MAX_TOKENS_N3_DIALOGO=4000
ESFUERZO_N5_SINTESIS=low
MAX_TOKENS_N5_SINTESIS=8000
# N8 (gpt-5): su parametrización supera los 60 s de espera del cliente (ADR-0010).
ESFUERZO_N8_ARQUITECTURA=low
MAX_TOKENS_N8_ARQUITECTURA=16000
TIEMPO_ESPERA_N8_ARQUITECTURA=300
# N10 (gpt-6.1-sol): una llamada produce el módulo completo con pruebas y documentación (ADR-0011).
ESFUERZO_N10_GENERACION=low
MAX_TOKENS_N10_GENERACION=32000
TIEMPO_ESPERA_N10_GENERACION=600

# --- Azure OpenAI (modo remoto, desarrollo y medición) ---
# Raíz del recurso, p. ej. https://<recurso>.openai.azure.com/ (el código agrega /openai/v1/).
# La API v1 no usa versión de API.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=

# --- Modelo local (modo sin dependencia de nube, RF-37) ---
OLLAMA_BASE_URL=http://localhost:11434

# --- Embeddings locales ---
EMBEDDINGS_MODELO=BAAI/bge-m3
EMBEDDINGS_DIMENSION=1024
# Servicio TEI de docker compose; el modelo se carga desde el volumen, sin conexión externa.
EMBEDDINGS_URL=http://localhost:8081

# --- Recuperación híbrida (RF-31, RF-32) ---
# Fragmentos por consulta, candidatos por búsqueda antes de la fusión y similitud mínima.
# El umbral 0.37 se calibró con BGE-M3 sobre el corpus (ADR-0007).
RAG_FRAGMENTOS=5
RAG_CANDIDATOS=20
RAG_UMBRAL_SIMILITUD=0.37

# --- Entorno aislado del código generado (RNF-03, ADR-0011) ---
# Imagen construida con `docker compose --profile sandbox build sandbox`; un contenedor efímero
# sin red por ejecución, con tiempo límite en segundos y límites de memoria, CPU y procesos.
SANDBOX_IMAGEN=multiagente-sandbox:1
SANDBOX_TIEMPO_LIMITE_S=60
SANDBOX_MEMORIA=512m
SANDBOX_CPUS=1
SANDBOX_PROCESOS=128

# --- Base de datos ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=multiagente
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- Control de costo (RNF-10) ---
PRESUPUESTO_MAXIMO_POR_MODULO_USD=
MAX_ITERACIONES_CORRECCION=3

# --- Orquestador: límite de turnos del ciclo conversacional N3–N4 ---
MAX_TURNOS_ELICITACION=15
# Retornos automáticos de N6 a N5 por defectos de calidad antes de escalar al analista.
MAX_CORRECCIONES_CALIDAD=2
# Retornos automáticos de N9 a N8 por errores del Anexo B antes de escalar al arquitecto humano.
MAX_CORRECCIONES_DISENO=2

# --- Observabilidad ---
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# LangGraph instala langsmith, que envía trazas a la nube de LangChain si esto se activa.
# Debe quedar en false (RNF-04).
LANGSMITH_TRACING=false
