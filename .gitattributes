# Normaliza finales de línea a LF en el repositorio.
* text=auto eol=lf

# Estos archivos se ejecutan dentro de contenedores Linux y fallan con CRLF.
*.sh text eol=lf
*.py text eol=lf
Dockerfile text eol=lf
*.dockerfile text eol=lf
docker-compose*.yml text eol=lf
*.sql text eol=lf

# Scripts propios de Windows conservan CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf

# Binarios
*.png binary
*.jpg binary
*.pdf binary
*.docx binary
*.xlsx binary
*.pptx binary
*.zip binary
