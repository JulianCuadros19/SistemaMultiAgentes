# Entorno virtual y dependencias
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Secretos: NUNCA versionar
.env
*.key
*.pem

# Herramientas
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Resultados de las corridas de evaluación: se regeneran con los scripts
evaluacion/resultados/*
!evaluacion/resultados/.gitkeep

# Datos locales y modelos descargados. La carpeta existe en un clon limpio, para que la
# composición la monte con su dueño (ADR-0017).
data/local/*
!data/local/.gitkeep
modelos/
*.log

# Sistema operativo y editores
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*Zone.Identifier

# Documento de tesis en PDF: solo local; su transcripción está en docs/anexos.md
docs/anexos/
